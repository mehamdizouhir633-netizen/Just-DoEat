{
  "name": "just-do-eat",
  "version": "1.0.0",
  "private": true,
  "description": "Just Do Eat — commande de repas pour l'OFPPT (PWA + APK Android via Capacitor)",
  "scripts": {
    "prepare:www": "node -e \"const fs=require('fs');fs.rmSync('www',{recursive:true,force:true});fs.mkdirSync('www');['index.html','sw.js','manifest.webmanifest','css','js','icons','img'].forEach(f=>fs.cpSync(f,'www/'+f,{recursive:true}))\"",
    "android:add": "npx cap add android",
    "android:sync": "npm run prepare:www && npx cap sync android",
    "serve": "python3 -m http.server 8080"
  },
  "dependencies": {
    "@capacitor/android": "^6.2.0",
    "@capacitor/cli": "^6.2.0",
    "@capacitor/core": "^6.2.0"
  }
}
